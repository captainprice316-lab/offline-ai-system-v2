# Python
venv/
__pycache__/
*.py[cod]
*.pyo
src/__pycache__/

# Models (large binaries — not tracked in git)
models/

# Runtime outputs and logs
output/
logs/
database/
robustness_cache/

# Training data, checkpoints, fine-tune runs
finetune_runs/
training/
training data/

# Audio test data
eval_audio/
input_audio/

# eval_data holds a 136 MB Common Voice corpus alongside the evaluation
# hypotheses. Ignore the contents, but KEEP the per-clip hypothesis files: they
# are ~8 MB total and are what allows a result to be re-scored under a different
# normalisation ruler, significance-tested, or error-analysed WITHOUT a GPU or
# the multi-GB adapters. docs/*.json carries the summary numbers; these carry
# the evidence behind them.
eval_data/*
!eval_data/*.jsonl

# Documents/papers (binary, not source)
*.pdf
*.docx
*.pptx
*.zip

# TeX aux files
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Claude metadata
.claude/
memory/

# HuggingFace cache
models/_hf_cache/

# Lock/temp files
~$*
*.lock

# Windows
Thumbs.db
.DS_Store

# Demo intercept audio — regenerable via generate_demo_audio.py
demo_audio/*.wav

# 3-node integration: large data — junction to E: + FLEURS dataset cache (not source)
finetune_runs_seamless/
scripts/data/fleurs/

# HuggingFace datasets download cache written by scripts/eval/* (FLEURS, IndicVoices).
# Downloaded data, not source; ~17 GB. Re-downloadable. Belongs on E: ideally.
data/

# Scratch / session temp (test wavs, logs, extracted node output)
scratchpad/

# Keep the integration process-overview PDF despite the global *.pdf rule
!integration/PROCESS_OVERVIEW.pdf

# Keep the professor-facing deliverable PDFs despite the global *.pdf rule
!docs/VANI_Finetune_Report.pdf
!docs/VANI_Presentation_Companion.pdf

# Keep the presentation deck despite the global *.pptx rule. It is the second
# half of the "regenerate reports after any training change" deliverable pair,
# and was silently untracked until 2026-07-28 while commit messages claimed
# otherwise. Regenerate with generate_finetune_pptx.py; commit the result.
!docs/VANI_Finetune_Presentation_v6.pptx
